<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest of Bivio.exe, embedded by bivio.rc. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Bivio" version="1.0.0.0"/>

  <!-- Common controls v6: themed controls, text-box placeholders (EM_SETCUEBANNER) and
       SetWindowSubclass, all used by the settings window. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <!-- Runs as the current user: no elevation prompt (nothing here needs administrator rights). -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Declares Windows 10/11 support, so Windows reports its real version and enables current behaviour. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- System DPI aware: Windows doesn't bitmap-stretch the windows, which are laid out for the system DPI
       (see S() in settings.c). On a second monitor with a different scale Windows stretches them. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
